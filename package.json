{
  "name": "autonomous-ai-creator",
  "version": "1.0.0",
  "description": "Autonomous AI & technology persona agent that independently discovers, judges, and publishes content.",
  "main": "dist/index.js",
  "scripts": {
    "build:server": "tsc",
    "build:client": "cd client && npm install && npm run build",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/index.js",
    "dev:server": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^0.15.0",
    "mongoose": "^8.3.1",
    "natural": "^8.0.1",
    "node-cron": "^3.0.3",
    "rss-parser": "^3.13.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/natural": "^5.1.5",
    "@types/node": "^20.12.7",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "concurrently": "^8.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
